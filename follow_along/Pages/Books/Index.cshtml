@page
@model follow_along.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<partial name="_StatusMessage"
         model="@TempData["StatusMessage"] as string" />

<form method="get" class="mb-3">
    <input asp-for="SearchTerm"
           class="form-control"
           placeholder="Search by title or author" />

    <button type="submit"
            class="btn btn-primary mt-2">
        Search
    </button>

    <a asp-page="./Index"
       class="btn btn-secondary mt-2">
        Clear
    </a>
</form>

<p>
    <a asp-page="/Books/Create" class="btn btn-primary">Create New</a>
</p>

@if (Model.Books.Count == 0)
{
    <p>No books yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.Books)
            {
                <partial name="_BookRow" model="book" />
            }
        </tbody>
    </table>
}