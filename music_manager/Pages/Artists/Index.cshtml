@page
@model music_manager.Pages.Artists.IndexModel
@{
    ViewData["Title"] = "Artists";
}

<h2>Artists</h2>

<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<p>
    <a asp-page="/Artists/Create" class="btn btn-primary">Create New</a>
</p>

@if (Model.Artists.Count == 0)
{
    <p>No artists yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Albums</th>
                <th>Songs</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var artist in Model.Artists)
            {
                <tr>
                    <td>@artist.Name</td>
                    <td>
                    @foreach(var album in artist.Albums)
                    {
                        <p>@album.Name</p>
                    }
                    </td>
                    <td>
                    @foreach(var song in artist.Songs)
                    {
                        <p>@song.Title</p>
                    }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}