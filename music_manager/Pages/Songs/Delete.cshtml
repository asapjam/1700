@page "{Id:int}"
@model music_manager.Pages.Songs.DeleteModel
@{
    ViewData["Title"] = "Delete Song";
}

<h2>Delete Song</h2>

<h3>Are you sure you want to delete this song?</h3>

@if (Model.Song is not null)
{
    <table class="table">
    <thead>
        <tr>
            <th><strong>Title:</strong></th>
            <th><strong>Release Year:</th>
            <th><strong>Genre:</strong></th>
            <th><strong>Album:</strong></th>
            <th><strong>Artist:</strong></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Song.Title</td>
            <td>@Model.Song.ReleaseYear</td>
            <td>@Model.Song.Genre</td>
            <td>@Model.Song.Album?.Name</td>
            <td>@Model.Song.Artist?.Name</td>
        </tr>
    </tbody>
    </table>
}

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>